#!/bin/bash
# husarion-base-check: is this image still a husarion/ros image underneath?
# Run it as the LAST RUN of every image built FROM husarion/ros. It fails when
#   - a package the base held (the patched Fast DDS) is no longer held, was
#     replaced by another version, or lost its +husarion revision;
#   - its files were overwritten (dpkg --verify) or another copy of the Fast
#     DDS library appeared outside /opt/ros/$ROS_DISTRO;
#   - the apt pin on it is gone;
#   - an apt source points at the live packages.ros.org instead of the
#     snapshot the base was built on.
# The record it checks against is /usr/share/husarion-ros/held, written when
# the base was built.
set -u
record=/usr/share/husarion-ros/held
fail=0
bad() { echo "husarion-base-check: $*" >&2; fail=1; }

[ -s "$record" ] || { echo "husarion-base-check: $record is missing: not a husarion/ros image" >&2; exit 1; }

held_now=$(apt-mark showhold | sort)
held_then=$(awk '{print $1}' "$record" | sort)
[ "$held_now" = "$held_then" ] || bad "the held package set changed: base held [$(echo $held_then)], now [$(echo $held_now)]"

while read -r pkg ver; do
    now=$(dpkg-query -W -f '${Version}' "$pkg" 2>/dev/null) || { bad "$pkg was removed (the base had $ver)"; continue; }
    [ "$now" = "$ver" ] || bad "$pkg is $now, the base had $ver: a child replaced the patched package"
    case "$now" in *+husarion*) ;; *) bad "$pkg $now carries no +husarion revision" ;; esac
    dpkg --verify "$pkg" >/dev/null 2>&1 || bad "$pkg's files were changed after install (dpkg --verify $pkg)"
    grep -qs "^Package: $pkg\$" /etc/apt/preferences.d/husarion-fastdds || bad "the apt pin on $pkg is gone (/etc/apt/preferences.d/husarion-fastdds)"
done < "$record"

others=$(find / -xdev \( -name 'libfastrtps.so*' -o -name 'libfastdds.so*' \) -type f -not -path "/opt/ros/${ROS_DISTRO}/lib/*" 2>/dev/null)
[ -z "$others" ] || bad "another Fast DDS library is in the image: $(echo $others)"

live=$(grep -rhsE '^[^#]*packages\.ros\.org' /etc/apt/sources.list /etc/apt/sources.list.d/ || true)
[ -z "$live" ] || bad "an apt source points at the live ROS repository, not the base's snapshot: $live"

if [ "$fail" = 0 ]; then
    echo "husarion-base-check: OK ($(tr '\n' ' ' < "$record"))"
fi
exit "$fail"
