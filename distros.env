# What each husarion/ros image is built from, one block per ROS 2 distro.
# Every value is a pin: change one only in its own commit, and release the
# distro afterwards (just release <distro>).
#
# <D>_CODENAME          Ubuntu release of the distro.
# <D>_ROS_CORE          the official ros:<distro>-ros-core index our ros-core is
#                       built FROM.
# <D>_ROS_BASE_OFFICIAL the official ros:<distro>-ros-base index of the same
#                       upstream build; test/ compares our ros-base's package set
#                       with it. Never built FROM.
# <D>_ROS_BASE_VERSION  the ros-<distro>-ros-base version the official ros-base
#                       Dockerfile installs (osrf/docker_images), mirrored.
# <D>_ROS_SNAPSHOT      the snapshots.ros.org date the image's ROS sources point
#                       at. It must carry exactly the stock Fast DDS build the
#                       patched .deb was made from (the build checks it).
# <D>_UBUNTU_SNAPSHOT   the snapshot.ubuntu.com timestamp of the Ubuntu sources.
#                       It must not be older than the official image's build.
# <D>_FASTDDS_PKG       the Fast DDS package name (Lyrical renamed it fastdds).
# <D>_FASTDDS_UPSTREAM  the upstream Fast DDS version the patched .deb carries.
# <D>_FASTDDS_SHA256_<arch>  sha256 of <pkg>-<distro>-<arch>.deb in the
#                       fastdds-patched release below (its SHA256SUMS).

FASTDDS_RELEASE=v6
# The revision suffix every package of that release carries.
FASTDDS_SUFFIX=+husarion8
# The signing key of snapshots.ros.org ("ROS Snapshot builder"), keys/ros-snapshots.asc.
ROS_SNAPSHOT_KEY_FPR=4B63CF8FDE49746E98FA01DDAD19BAB3CBF125EA

JAZZY_CODENAME=noble
JAZZY_ROS_CORE=ros:jazzy-ros-core@sha256:d0b8e70ceecc98a1d475c6b9ca96de9c90bf4e91e7163bf4c7543b794ff7d1f2
JAZZY_ROS_BASE_OFFICIAL=ros:jazzy-ros-base@sha256:5147d3ae250ce754afd399f6bfec15b33dd4e473ca357e30432a3182031bfad6
JAZZY_ROS_BASE_VERSION=0.11.0-1*
JAZZY_ROS_SNAPSHOT=2026-11-16
JAZZY_UBUNTU_SNAPSHOT=20261120T000000Z
JAZZY_FASTDDS_PKG=fastrtps
JAZZY_FASTDDS_UPSTREAM=2.14.7
JAZZY_FASTDDS_SHA256_amd64=7ac591ea5b6b980383b9a2ed8887a3d4edb0ec691de1b8fb0db4fa5ffb012ff6
JAZZY_FASTDDS_SHA256_arm64=9f9b8a24c4b6a4fa44755fdeaf941266945513d36ba0819d9bc83dd4861c44a0

HUMBLE_CODENAME=jammy
HUMBLE_ROS_CORE=ros:humble-ros-core@sha256:1f9ff77348bbd0a2c06c1ee222b71e2e6dbf54b73cff63387a7bd4467a23a354
HUMBLE_ROS_BASE_OFFICIAL=ros:humble-ros-base@sha256:a18afd4a42ad603579d03b9012385dfeaf2e848423f0a6c41699766e7849c86c
HUMBLE_ROS_BASE_VERSION=0.10.0-1*
