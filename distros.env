HUMBLE_FASTDDS_UPSTREAM=2.6.12
HUMBLE_FASTDDS_SHA256_amd64=e93d27415f36f7d8bdffaa712cc704e9883a7668bf1de06e9edb8a00a5ec056c
HUMBLE_FASTDDS_SHA256_arm64=fca353c5f49b16e34e7732adb006f39f2c80c942fea11dd6b6421a1b9f22c84f

